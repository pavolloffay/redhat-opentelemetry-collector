{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Only vulnerability/security PRs. This extends the global Mintmaker config https://github.com/konflux-ci/mintmaker/blob/main/config/renovate/renovate.json",
  "cloneSubmodules": true,
  "extends": ["security:only-security-updates"],
  "labels": ["dependencies"],
  "enabledManagers": ["gomod"],
  "includePaths": ["_build/**"],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDepNames": [
        "go.opentelemetry.io/collector{/,}**",
        "github.com/open-telemetry/opentelemetry-collector-contrib{/,}**"
      ],
      "enabled": false
    }
  ]
}

